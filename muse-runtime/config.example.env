# Public Ollama-compatible endpoint. Use 0.0.0.0 only on a trusted LAN.
MUSE_HOST=127.0.0.1
MUSE_PORT=11434

# llama.cpp stays private on loopback.
MUSE_BACKEND_HOST=127.0.0.1
MUSE_BACKEND_PORT=18080
MUSE_LLAMA_SERVER=/opt/homebrew/bin/llama-server
# Optional absolute Python 3.9+ path; otherwise the startup interpreter is used.
# MUSE_PYTHON=/opt/homebrew/bin/python3

# Download both files as described in docs/setup-runtime.md, then use absolute paths.
MUSE_MODEL_PATH="$HOME/Models/muse-glimmer/Muse-Glimmer-30B-KQuant-17GB-Q4_K_M.gguf"
MUSE_MMPROJ_PATH="$HOME/Models/muse-glimmer/mmproj-Muse-Glimmer-30B-Q4_K_M.gguf"
MUSE_MODEL_NAME=muse-glimmer:latest

# Four 8K cache slots in one 32K llama.cpp context allocation.
MUSE_SLOTS=4
MUSE_CONTEXT_SIZE=32768
MUSE_SESSION_TOKEN_LIMIT=8192
MUSE_TOTAL_CACHE_TOKEN_LIMIT=24576
MUSE_MAX_OUTPUT_TOKENS=2048
MUSE_LEASE_SECONDS=300

# Muse Glimmer is a hybrid sliding-window model. Keep slot snapshots disabled unless
# a newer llama.cpp build has been validated for hybrid checkpoint persistence.
MUSE_SNAPSHOT_MODE=disabled

# Model weights are independent from session leases.
MUSE_MODEL_UNLOAD_POLICY=keep_loaded
MUSE_MODEL_IDLE_SECONDS=900
MUSE_BACKEND_AUTOSTART=true

# Optional. If set, callers must send: Authorization: Bearer <value>
MUSE_API_KEY=
MUSE_LOG_LEVEL=INFO
